# Base de datos
# Local (Docker, ver docker-compose.yml). En producción, la connection string de Neon.
DATABASE_URL="postgresql://mjbj:mjbj@localhost:5433/mjbj"

# Better Auth
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# URL pública del sitio.
# La usan Mercado Pago y los correos para armar links absolutos: en desarrollo
# la request dice "localhost", que para un tercero no existe.
APP_URL="http://localhost:3000"
# También es la base de los enlaces del sitemap y de las URLs canónicas.

# SEO. Los despliegues que no son de producción se marcan "noindex" solos
# (Vercel expone VERCEL_ENV). Poner "no" acá lo fuerza también en producción,
# que es lo que hay que hacer si el sitio se publica antes de estar listo.
# SEO_INDEXAR="no"

# Casilla a la que llegan las consultas del formulario de contacto.
# Si no está, se usa info@mjbj.com.ar
# EMAIL_CONTACTO=""

# ─────────────────────────────────────────────────────────────────────────────
# Todo lo de abajo es opcional. Sin credenciales, cada módulo corre con su
# proveedor de demostración: el circuito completo funciona, no se manda nada
# real, y la interfaz lo avisa en pantalla.
# ─────────────────────────────────────────────────────────────────────────────

# Cobros — Mercado Pago
# El access token sale de las credenciales de la aplicación. En producción
# empieza con APP_USR; el de prueba con TEST. La clave del webhook se genera en
# el panel al dar de alta la URL https://<dominio>/api/pagos/webhook
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MP_PUBLIC_KEY=""
# PAGOS_PROVIDER="demo"   fuerza el proveedor de demostración

# Correo — Resend
# El dominio del remitente tiene que estar verificado (SPF y DKIM). Mandar desde
# un dominio sin verificar hace que el correo salga y caiga en spam, que es peor
# que no mandarlo.
RESEND_API_KEY=""
EMAIL_REMITENTE="Maderera Juan B. Justo <pedidos@mjbj.ar>"
EMAIL_RESPUESTAS=""
# EMAIL_PROVIDER="demo"   fuerza el proveedor de demostración

# WhatsApp — Cloud API de Meta
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_WEBHOOK_SECRET=""
WHATSAPP_BUSINESS_PHONE=""
# WHATSAPP_PROVIDER="demo"

# ARCA — facturación electrónica
# El certificado y la clave privada los tramita el cliente. Sin ellos corre el
# proveedor interno, que numera y emite sin CAE, marcado como sin valor fiscal.
ARCA_CUIT=""
ARCA_CERTIFICADO=""
ARCA_CLAVE_PRIVADA=""
ARCA_AMBIENTE="homologacion"

# Archivos — Vercel Blob
# Sin token, las subidas se guardan en public/subidas (solo sirve en desarrollo:
# el sistema de archivos de un servidor serverless no persiste entre deploys).
BLOB_READ_WRITE_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# Agente del taller (opcional).
# Token compartido con el script que corre en la PC del aserradero y deja los
# archivos de corte en la carpeta del optimizador. Ver agente-taller/README.md.
# Sin esta variable la integración está apagada: los endpoints responden 404.
# Generar con: openssl rand -base64 32
# CORTES_AGENTE_TOKEN=""
