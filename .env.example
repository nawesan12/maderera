# Base de datos
# Local (Docker, ver docker-compose.yml). En producción, la connection string de Neon.
DATABASE_URL="postgresql://mjbj:mjbj@localhost:5433/mjbj"

# Better Auth
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# URL pública del sitio.
# La usan Mercado Pago y los correos para armar links absolutos: en desarrollo
# la request dice "localhost", que para un tercero no existe.
APP_URL="http://localhost:3000"
# También es la base de los enlaces del sitemap y de las URLs canónicas.

# SEO. Los despliegues que no son de producción se marcan "noindex" solos
# (Vercel expone VERCEL_ENV; en el servidor propio, APP_ENV). Poner "no" acá lo
# fuerza también en producción, que es lo que hay que hacer si el sitio se
# publica antes de estar listo.
# En el servidor propio **declararla siempre**, "si" o "no": se hornea en el
# build (robots.txt es estático) y no hay plataforma que proteja a una copia de
# prueba de terminar en Google.
# SEO_INDEXAR="no"

# Casilla a la que llegan las consultas del formulario de contacto.
# Si no está, se usa info@mjbj.com.ar
# EMAIL_CONTACTO=""

# ─────────────────────────────────────────────────────────────────────────────
# Todo lo de abajo es opcional. Sin credenciales, cada módulo corre con su
# proveedor de demostración: el circuito completo funciona, no se manda nada
# real, y la interfaz lo avisa en pantalla.
# ─────────────────────────────────────────────────────────────────────────────

# Cobros — Mercado Pago
# El access token sale de las credenciales de la aplicación. En producción
# empieza con APP_USR; el de prueba con TEST. La clave del webhook se genera en
# el panel al dar de alta la URL https://<dominio>/api/pagos/webhook
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MP_PUBLIC_KEY=""
# PAGOS_PROVIDER="demo"   fuerza el proveedor de demostración

# Correo — Resend
# El dominio del remitente tiene que estar verificado (SPF y DKIM). Mandar desde
# un dominio sin verificar hace que el correo salga y caiga en spam, que es peor
# que no mandarlo.
RESEND_API_KEY=""
EMAIL_REMITENTE="Maderera Juan B. Justo <pedidos@mjbj.ar>"
EMAIL_RESPUESTAS=""
# EMAIL_PROVIDER="demo"   fuerza el proveedor de demostración

# WhatsApp — Cloud API de Meta
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_WEBHOOK_SECRET=""
WHATSAPP_BUSINESS_PHONE=""
# WHATSAPP_PROVIDER="demo"

# ARCA — facturación electrónica
# El certificado y la clave privada los tramita el cliente. Sin ellos corre el
# proveedor interno, que numera y emite sin CAE, marcado como sin valor fiscal.
ARCA_CUIT=""
ARCA_CERTIFICADO=""
ARCA_CLAVE_PRIVADA=""
ARCA_AMBIENTE="homologacion"

# Archivos — Vercel Blob
# Sin token, las subidas se guardan en disco: en desarrollo en public/subidas, y
# en el servidor propio en CARPETA_SUBIDAS (ver abajo). En Vercel hace falta:
# el sistema de archivos de un servidor serverless no persiste entre deploys.
# **En el servidor propio tiene que quedar vacío**: con token, las fotos nuevas
# seguirían yendo a Vercel.
BLOB_READ_WRITE_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# Agente del taller (opcional).
# Token compartido con el script que corre en la PC del aserradero y deja los
# archivos de corte en la carpeta del optimizador. Ver agente-taller/README.md.
# Sin esta variable la integración está apagada: los endpoints responden 404.
# Generar con: openssl rand -base64 32
# CORTES_AGENTE_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# Reseñas de Google (opcional).
# Con las dos, el panel puede traer solas las reseñas de la ficha del negocio
# (/admin/contenido/resenas-negocio). Sin ellas, las reseñas se copian a mano y
# el sitio funciona igual: nunca se consulta a Google al mostrar la portada.
# El id del lugar sale de la ficha de Google Business.
# GOOGLE_PLACES_API_KEY=""
# GOOGLE_PLACE_ID=""

# ─────────────────────────────────────────────────────────────────────────────
# Avisos del panel en el teléfono (Web Push).
# Con estas dos, el panel avisa cuando entra una venta por el sitio o se
# acredita un pago —es lo que la clienta pidió al ver cómo funciona Tiendanube—.
# Sin ellas no falla nada: el botón de activar avisos dice qué falta y todo lo
# demás sigue igual.
# Se generan una vez y no vencen:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:info@mjbj.com.ar"

# ═════════════════════════════════════════════════════════════════════════════
# Servidor propio (docker-compose.prod.yml)
# ═════════════════════════════════════════════════════════════════════════════
#
# Solo hacen falta si la app corre en el VPS en vez de Vercel. Ahí el archivo
# se llama `.env.produccion`, vive en el servidor y nunca en el repositorio
# (`.gitignore` y `.dockerignore` lo dejan afuera). Guía completa en
# docs/SERVIDOR-PROPIO.md.
#
# En el servidor, además de estas, van las de arriba con sus valores reales:
# BETTER_AUTH_SECRET, BETTER_AUTH_URL="https://mjbj.ar", APP_URL="https://mjbj.ar"
# —**obligatoria: sin ella el servidor no arranca**—, Mercado Pago, Resend,
# WhatsApp, ARCA_CUIT y ARCA_AMBIENTE, VAPID_*.
#
# `DATABASE_URL` no se pone: la arma el compose con los POSTGRES_* y el nombre
# interno del contenedor de la base.

# Qué clase de despliegue es. "production" en el servidor de la maderera;
# cualquier otro valor ("staging") en una copia de prueba, que entonces sale
# con "noindex". Es lo que en Vercel decía VERCEL_ENV.
# APP_ENV="production"

# La base del compose. La contraseña, solo letras y números —va adentro de una
# URL—: openssl rand -hex 32
# POSTGRES_USER="mjbj"
# POSTGRES_PASSWORD=""
# POSTGRES_DB="mjbj"

# Cifrado de la conexión a la base: "on" u "off". Sin declarar, se cifra salvo
# que la URL diga localhost (la regla de siempre: Neon sí, el Docker local no).
# El compose ya la pone en "off": la base está en la misma máquina, en una red
# privada de Docker, y su Postgres no admite SSL.
# DATABASE_SSL="off"

# Cuántas conexiones abre la aplicación contra la base. 10 por omisión; ver el
# comentario en lib/db/index.ts antes de cambiarlo.
# DATABASE_POOL_MAX="10"

# El dominio que atiende Caddy, sin https:// ni barra. De acá sale el
# certificado, así que tiene que ser el nombre real y apuntar a la IP del
# servidor antes de levantar nada. www.<dominio> redirige acá.
# DOMINIO="mjbj.ar"

# Dónde se guardan las fotos que se suben del panel. El compose ya la pone en
# /datos/subidas, que es un volumen: fuera de `public/` y de la imagen, así no
# se pierden en cada despliegue. Caddy la sirve en /subidas/.
# CARPETA_SUBIDAS="/datos/subidas"

# El certificado de ARCA, como archivos. El compose ya trae estas dos rutas:
# alcanza con dejar arca.crt y arca.key en secretos/arca/ del servidor. Si
# ARCA_CERTIFICADO o ARCA_CLAVE_PRIVADA tienen contenido, ganan ellas.
# ARCA_CERTIFICADO_ARCHIVO="/run/secrets/arca/arca.crt"
# ARCA_CLAVE_PRIVADA_ARCHIVO="/run/secrets/arca/arca.key"

# Respaldo diario de la base: cuántos días se guardan en el disco del servidor.
# RESPALDO_DIAS="14"

# Copia de los respaldos fuera de la máquina (opcional, recomendable). Un
# destino de rclone ya configurado en secretos/rclone/rclone.conf, con la
# carpeta: por ejemplo "b2:mjbj-respaldos" o "gdrive:respaldos/mjbj". Allá se
# guardan RCLONE_DIAS días.
# RCLONE_REMOTE=""
# RCLONE_DIAS="90"

# Dónde corre: "vps" en el servidor propio (lo pone el compose, no hace falta
# escribirlo). Enciende el tiempo real del panel —la bandeja de WhatsApp, el
# taller y los pedidos nuevos se actualizan solos—, que necesita un proceso que
# viva. Sin declarar (Vercel), las pantallas vuelven a consultar cada tanto.
# PLATAFORMA=""

# Las tareas programadas (lib/tareas): el contenedor `cron` llama a
# /api/tareas/<nombre> con este secreto. **Obligatorio en el servidor**: sin él
# el compose no levanta. Sin declararlo, la ruta contesta 404 (así en Vercel o
# en una copia de prueba nadie puede dispararlas).
# Generar con: openssl rand -base64 32
# TAREAS_SECRETO=""

# ─── Correo propio (solo en el servidor; ver «Correo propio» en
# docs/SERVIDOR-PROPIO.md) ─────────────────────────────────────────────────
#
# Enciende el servidor de correo y el webmail del compose (servicios `correo` y
# `webmail`). Sin esto, el resto del servidor anda igual y no hay casillas.
# COMPOSE_PROFILES="correo"
#
# El envío de la aplicación (avisos y campañas) por ese servidor en vez de
# Resend. Las casillas se crean con `scripts/correo.sh alta avisos@<dominio>`.
#
# **SPOOF_PROTECTION está encendido**: la aplicación solo puede mandar como la
# casilla con que entra (o un alias suyo). EMAIL_REMITENTE tiene que ser esa
# misma dirección: con SMTP_USUARIO="avisos@mjbj.ar", el remitente es
# "Maderera Juan B. Justo <avisos@mjbj.ar>". Si se quiere que salga como
# `pedidos@`, crear la casilla `pedidos@` y usar esa.
# EMAIL_PROVIDER="smtp"
# SMTP_USUARIO="avisos@mjbj.ar"
# SMTP_CLAVE=""
#
# Cuántos correos por minuto manda una campaña. Por omisión, 3 con el SMTP
# propio (Hostinger deja salir 5 por minuto y hay que dejar lugar a los avisos)
# y 60 con Resend. Con un relay configurado (`scripts/correo.sh relay`), subirlo.
# CAMPANAS_POR_MINUTO=""
#
# Estos tres ya los pone el compose y no hace falta escribirlos: el nombre
# interno del contenedor, el puerto de envío autenticado y el nombre del
# certificado (la app se conecta a `correo` pero verifica `mail.<dominio>`).
# SMTP_HOST="correo"
# SMTP_PUERTO="587"
# SMTP_NOMBRE_TLS="mail.mjbj.ar"
#
# Se puede seguir con Resend para los avisos y tener las casillas acá: Resend
# firma con su propio DKIM y usa su subdominio (`send.`) para los rebotes, así
# que los registros que pide se cargan además de estos y el SPF del dominio no
# cambia.
#
# Los buzones entran en el respaldo diario junto con la base. "no" para
# sacarlos (por ejemplo, si ocupan demasiado para la copia fuera de la máquina).
# CORREO_RESPALDO="si"
#
# Solo para probar en una máquina sin dominio real (certificados internos de
# Caddy): la ruta del certificado dentro del volumen de Caddy. En el servidor
# no se escriben: el compose ya apunta al de Let's Encrypt.
# CORREO_CERTIFICADO=""
# CORREO_CLAVE_CERTIFICADO=""
