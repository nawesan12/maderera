# El que atiende internet.
#
# Caddy y no Nginx por una sola razón que importa acá: saca y renueva el
# certificado de Let's Encrypt solo, sin cron ni certbot. El certificado
# vencido un domingo es de los problemas más tontos y más caros que puede
# tener una tienda, y con esto no puede pasar.
#
# **Las cabeceras de seguridad no están acá.** Viven en `next.config.ts` y
# salen con cada respuesta de la aplicación; repetirlas en dos lados es la
# forma de que un día digan cosas distintas. La única excepción es
# `/subidas/`, que Caddy sirve del disco sin pasar por Next (ver abajo).

# El `www` lleva al dominio sin `www`, y lo mismo el dominio alternativo
# (`mjbj.ar`, con y sin `www`, cuando el principal es `mjbj.com.ar`): un 301
# conserva lo que Google ya tiene indexado y los enlaces viejos. La lista la
# arma el compose (`REDIRIGIDOS`). Cada nombre necesita su registro DNS
# apuntando a la misma IP: si falta, Caddy no puede sacar ese certificado y lo
# reintenta en el registro, sin afectar al dominio principal.
{$REDIRIGIDOS} {
	redir https://{$DOMINIO}{uri} permanent
}

# El nombre del servidor de correo. Caddy no le sirve nada a nadie acá: el
# bloque existe para que saque y renueve el certificado de `mail.<dominio>`,
# que el contenedor `correo` lee de su volumen (ver docker-compose.prod.yml).
#
# **El emisor va fijo en Let's Encrypt.** La ruta del certificado en el
# volumen lleva el nombre del emisor, y Caddy, si Let's Encrypt falla, prueba
# con otro: el certificado quedaría en otra carpeta y el correo seguiría con el
# viejo hasta vencerse. Mejor que falle a la vista, en el registro de Caddy.
#
# Si el correo propio no está encendido y el registro DNS de `mail` no existe,
# Caddy reintenta en el registro sin afectar al sitio.
mail.{$DOMINIO} {
	tls {
		ca https://acme-v02.api.letsencrypt.org/directory
	}
	respond "Servidor de correo de {$DOMINIO}. Para leer el correo: https://webmail.{$DOMINIO}" 200
}

# El webmail (Roundcube, servicio `webmail`, solo con el perfil `correo`).
webmail.{$DOMINIO} {
	log {
		output file /var/log/caddy/webmail.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json {
			time_format iso8601
		}
	}
	# Adjuntos de hasta 25 MB más lo que agrega la codificación.
	request_body {
		max_size 40MB
	}
	reverse_proxy webmail:8000
	encode zstd gzip
}

# La configuración automática de Thunderbird (y de otros que leen el mismo
# formato): se pone la dirección y la clave, y el programa encuentra solo el
# servidor, los puertos y el cifrado. Necesita el registro DNS `autoconfig`.
autoconfig.{$DOMINIO} {
	handle /mail/config-v1.1.xml {
		header Content-Type "application/xml; charset=utf-8"
		respond <<XML
			<?xml version="1.0" encoding="UTF-8"?>
			<clientConfig version="1.1">
			  <emailProvider id="{$DOMINIO}">
			    <domain>{$DOMINIO}</domain>
			    <displayName>Maderera Juan B. Justo</displayName>
			    <incomingServer type="imap">
			      <hostname>mail.{$DOMINIO}</hostname>
			      <port>993</port>
			      <socketType>SSL</socketType>
			      <username>%EMAILADDRESS%</username>
			      <authentication>password-cleartext</authentication>
			    </incomingServer>
			    <outgoingServer type="smtp">
			      <hostname>mail.{$DOMINIO}</hostname>
			      <port>465</port>
			      <socketType>SSL</socketType>
			      <username>%EMAILADDRESS%</username>
			      <authentication>password-cleartext</authentication>
			    </outgoingServer>
			  </emailProvider>
			</clientConfig>
			XML 200
	}
	respond 404
}

{$DOMINIO} {
	# El registro de acceso, en JSON y con fecha legible. Es el que lee
	# fail2ban (ver docs/SERVIDOR-PROPIO.md) para banear a quien anda tanteando
	# las rutas de abajo; el `client_ip` de cada línea es la IP real.
	log {
		output file /var/log/caddy/acceso.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json {
			time_format iso8601
		}
	}

	# Las sondas de siempre: WordPress, `.env`, `.git`, phpMyAdmin. Nada de eso
	# existe en este sitio y cada pedido es un robot buscando una puerta.
	# Contestarlas desde acá es no despertar a Node para decir que no, y que
	# queden en el registro con un 404 es lo que fail2ban usa para banear.
	@sondas {
		path /wp-admin* /wp-login.php /wp-content/* /wp-includes/* /xmlrpc.php /wordpress* /.env* /.git* /.aws* /.ssh* /phpmyadmin* /pma* /cgi-bin/* /vendor/phpunit/* /server-status /actuator* *.php
	}
	handle @sondas {
		respond 404
	}

	# Las fotos subidas desde el panel las sirve Caddy directo del volumen, sin
	# despertar a Node. Cada nombre lleva un UUID y nunca se reescribe, así que
	# se pueden cachear para siempre.
	#
	# Es la única respuesta que no pasa por Next, y por eso es el único lugar
	# con cabeceras propias: `nosniff` para que un adjunto de WhatsApp no se
	# interprete como otra cosa, y una CSP que no deja ejecutar nada si alguien
	# logra que se abra un archivo como página.
	handle_path /subidas/* {
		root * /datos/subidas
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		header Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox"
		file_server
	}

	# Todo lo demás va a la aplicación.
	handle {
		# Lo que Next ya marca como inmutable —los JS y CSS con hash en el
		# nombre— se refuerza acá por si algún día una respuesta llega sin la
		# cabecera. No cambia nada para el resto de las rutas.
		header /_next/static/* {
			Cache-Control "public, max-age=31536000, immutable"
			# Después de que responde la aplicación; si no, la cabecera de
			# Next pisaría a esta.
			defer
		}

		# El tope de lo que se puede mandar: el comprobante más grande que se
		# acepta son 16 MB. Sin tope, cualquiera puede tener ocupada a la
		# aplicación leyendo un cuerpo infinito.
		request_body {
			max_size 25MB
		}

		reverse_proxy app:3000 {
			# **La IP del cliente, sin que el cliente la pueda inventar.** Caddy
			# no confía en el `X-Forwarded-For` que llega de afuera —no hay
			# `trusted_proxies` declarados— y lo reemplaza por la IP real de la
			# conexión, así que el primer valor que lee `lib/limites` es
			# siempre el verdadero. `X-Real-IP` se pisa por lo mismo.
			header_up X-Real-IP {remote_host}

			# Que las respuestas en streaming —las páginas con Suspense, el
			# asistente— lleguen a medida que se arman y no todas juntas al
			# final.
			flush_interval -1
		}
	}

	# Todo comprimido salvo los avisos en vivo: comprimir un flujo SSE lo
	# junta en un buffer hasta llenar el bloque, y el aviso del pedido nuevo
	# llegaría cuando hubiera varios.
	@comprimible not path /api/vivo
	encode @comprimible zstd gzip
}
