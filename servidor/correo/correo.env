# La configuración del servidor de correo (docker-mailserver 16), sin nada
# secreto: lo secreto —las casillas y sus claves, las llaves DKIM— vive en el
# volumen `correo_config` y lo escribe `scripts/correo.sh`.
#
# Lo que depende del dominio (el certificado, el postmaster) lo pone el compose,
# que sabe cuál es. Referencia de cada variable:
# https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/

LOG_LEVEL=info
TZ=America/Argentina/Buenos_Aires

# **Rspamd en vez de la pila vieja** (OpenDKIM + OpenDMARC + policyd-spf +
# Amavis + SpamAssassin). Es lo que recomienda la documentación actual: un solo
# servicio que firma DKIM, verifica SPF/DKIM/DMARC de lo que entra y filtra
# spam, con bastante menos memoria que cinco procesos separados. En una VPS
# chica que además corre la tienda, la memoria es lo que importa.
ENABLE_RSPAMD=1
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
# Lo que alguien mueve a «Correo no deseado» le enseña al filtro, y lo que saca
# de ahí también. Sin esto, el filtro no mejora nunca.
RSPAMD_LEARN=1
MOVE_SPAM_TO_JUNK=1
# Sin greylisting: demora el primer correo de cada remitente nuevo hasta media
# hora, y en un comercio el primer correo de un cliente nuevo es justamente el
# que no se puede demorar.
RSPAMD_GREYLISTING=0

# **Sin antivirus.** ClamAV solo pide más de 1 GB de memoria para sus firmas, y
# es lo que tiraría abajo una VPS de 4 GB. Los adjuntos ejecutables los frena
# igual Rspamd; si algún día la máquina crece, se prende acá.
ENABLE_CLAMAV=0

# Solo IMAP cifrado (993) para leer y 587/465 para mandar. Nada de POP3: baja
# los correos a una sola máquina y los borra del servidor, que es lo contrario
# de lo que se quiere con una casilla que se mira desde el teléfono y la PC.
ENABLE_IMAP=1
ENABLE_POP3=0

# Quien entra con una casilla solo puede mandar como esa casilla (o sus
# alias). Sin esto, cualquiera con la clave de `ventas@` podría firmar como
# `administracion@`.
SPOOF_PROTECTION=1

# Banea por una semana a quien prueba claves (6 intentos fallidos). Las redes
# privadas de Docker quedan afuera: ver `fail2ban-jail.cf`.
ENABLE_FAIL2BAN=1

# Nadie de la red de Docker manda sin clave, tampoco la aplicación: entra con
# su propia casilla por el 587, como cualquier programa de correo.
PERMIT_DOCKER=none

# El correo más grande que se acepta: 25 MB, lo mismo que deja Gmail. Un
# presupuesto con planos en PDF pasa; un video no.
POSTFIX_MESSAGE_SIZE_LIMIT=26214400

# Avisa al postmaster cuando sale una versión nueva de la imagen. La versión
# está fijada en el compose, así que actualizar es una decisión, no una
# sorpresa: este aviso es para que la decisión no se olvide.
ENABLE_UPDATE_CHECK=1
UPDATE_CHECK_INTERVAL=7d

SSL_TYPE=manual
